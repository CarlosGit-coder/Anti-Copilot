# Banco e estado local gerados pelo ChromaDB
data/chroma/

# Repositórios clonados para consulta local e documentos privados do usuário
data/raw/repositories/
data/raw/private/

# PDFs não devem ser adicionados ao Git por padrão; o catálogo registra a origem.
data/raw/**/*.pdf

# Arquivos produzidos pelo Python
__pycache__/
*.py[cod]
